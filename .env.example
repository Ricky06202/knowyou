# PostgreSQL (used by docker-compose)
POSTGRES_USER=knowyou
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=knowyou

# Database connection URL (host=postgres when using docker-compose, localhost for local dev)
DATABASE_URL=postgresql://knowyou:change_this_password@postgres:5432/knowyou

# JWT secrets (change these!)
JWT_ACCESS_SECRET=generate-a-random-access-secret-here
JWT_REFRESH_SECRET=generate-a-random-refresh-secret-here

# CORS - frontend domains allowed
CORS_ORIGIN=https://knowyou.devspacex.net,https://api.knowyou.devspacex.net

# External API keys
RAWG_API_KEY=95e84b7f309440b6ad28e3631bd0a879
TMDB_API_KEY=359c6067417dad722b9f0a9d9683159c
DEEPSEEK_API_KEY=sk-fcd3b3669fba48428d73454f3ed54595
OMDB_API_KEY=a36d7578

# Server
PORT=3001

# Android APK download path (server-side file path)
APK_PATH=/data/knowyou.apk
