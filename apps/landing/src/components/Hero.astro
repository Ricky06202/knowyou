---

---

<section class="relative min-h-screen flex flex-col items-center justify-center px-6 py-20 overflow-hidden">
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-indigo-600/20 rounded-full blur-3xl animate-float-slow"></div>
    <div class="absolute bottom-1/4 right-1/4 w-80 h-80 bg-purple-600/20 rounded-full blur-3xl animate-float-slower"></div>
    <div class="absolute top-1/3 right-1/3 w-64 h-64 bg-pink-600/15 rounded-full blur-3xl animate-float-slowest"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(99,102,241,0.03)_0%,transparent_70%)]"></div>
  </div>

  <div class="relative z-10 text-center max-w-4xl mx-auto animate-fade-in">
    <div class="mb-8 animate-fade-in-up">
      <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-sm font-medium">
        <span class="w-2 h-2 rounded-full bg-indigo-400 animate-pulse"></span>
        Powered by AI &middot; Recomendaciones inteligentes
      </span>
    </div>

    <h1 class="text-5xl sm:text-6xl md:text-7xl font-extrabold mb-6 leading-[1.1] tracking-tight animate-fade-in-up" style="animation-delay: 0.1s">
      La app que
      <span class="gradient-text">te conoce</span>
      <br />
      <span class="text-white">y te recomienda</span>
    </h1>

    <p class="text-lg sm:text-xl md:text-2xl text-gray-400 mb-10 max-w-2xl mx-auto leading-relaxed animate-fade-in-up" style="animation-delay: 0.2s">
      Chatea con un asistente que aprende tus gustos en
      <span class="text-white font-semibold">videojuegos, películas, series y anime</span>.
      Cada recomendación se acerca más a lo que te encanta.
    </p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center animate-fade-in-up" style="animation-delay: 0.3s">
      <a
        href="#download"
        class="group relative inline-flex items-center gap-3 gradient-bg text-white font-semibold px-8 py-4 rounded-xl text-lg transition-all duration-300 hover:scale-105 animate-glow-pulse"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        Descargar APK
        <span class="absolute -inset-1 bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500 rounded-xl blur-2xl opacity-0 group-hover:opacity-60 transition-opacity duration-500 -z-10"></span>
      </a>
      <a
        href="#features"
        class="inline-flex items-center gap-2 text-gray-400 hover:text-white font-medium px-8 py-4 rounded-xl text-lg border border-gray-800 hover:border-gray-500 transition-all duration-300"
      >
        Conocer más
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </a>
    </div>

    <div class="mt-16 md:mt-20 grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12 text-center animate-fade-in-up" style="animation-delay: 0.4s">
      <div class="group">
        <div class="text-3xl md:text-4xl font-bold gradient-text">5</div>
        <div class="text-gray-500 text-sm mt-1.5 group-hover:text-gray-300 transition-colors">Categorías</div>
      </div>
      <div class="group">
        <div class="text-3xl md:text-4xl font-bold gradient-text">500K+</div>
        <div class="text-gray-500 text-sm mt-1.5 group-hover:text-gray-300 transition-colors">Videojuegos</div>
      </div>
      <div class="group">
        <div class="text-3xl md:text-4xl font-bold gradient-text">1M+</div>
        <div class="text-gray-500 text-sm mt-1.5 group-hover:text-gray-300 transition-colors">Películas y Series</div>
      </div>
      <div class="group">
        <div class="text-3xl md:text-4xl font-bold gradient-text">AI</div>
        <div class="text-gray-500 text-sm mt-1.5 group-hover:text-gray-300 transition-colors">Recomendaciones</div>
      </div>
    </div>
  </div>
</section>
